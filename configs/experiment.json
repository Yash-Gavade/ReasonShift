{
  "seed": 42,
  "samples_per_dataset": 50,
  "datasets": [
    "gsm8k",
    "commonsense_qa",
    "logiqa"
  ],
  "conditions": [
    "original",
    "lexical",
    "syntactic",
    "information_order"
  ],
  "optional_conditions": [
    "distractor"
  ],
  "models": [
    "Qwen/Qwen2.5-3B-Instruct",
    "meta-llama/Llama-3.2-3B-Instruct",
    "Gemma small instruct checkpoint \u2014 freeze after pilot"
  ],
  "decoding": {
    "do_sample": false,
    "final_answer_only": true
  },
  "primary_metrics": [
    "accuracy_by_condition",
    "accuracy_delta",
    "correctness_flip_rate",
    "degradation_flip_rate",
    "recovery_flip_rate",
    "robust_accuracy_core"
  ],
  "statistics": [
    "McNemar paired test",
    "question-group bootstrap 95% CI"
  ],
  "manual_analysis": "failure-transition annotation of informative paired cases"
}